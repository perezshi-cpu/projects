---
import { getArtistFallback } from '../lib/artistFallback';

export interface Props {
  name: string;
  origin: string;
  genre: string;
  day: string;
  stage: string;
  time: string;
  photo?: string;
  photoPosition?: string;
  headliner?: boolean;
  bio?: string;
  videoUrl?: string;
}

const { name, origin, genre, day, stage, time, photo, photoPosition, bio, videoUrl } = Astro.props;

// Fallback gradient if no photo
const { hue, hue2, initials } = getArtistFallback(name);
---

<div
  class="card-glass artist-card"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
  aria-label={`צפו במידע על ${name}`}
  data-artist-trigger
  data-name={name}
  data-day={day}
  data-stage={stage}
  data-time={time}
  data-genre={genre}
  data-origin={origin}
  data-photo={photo ?? ''}
  data-photo-position={photoPosition ?? ''}
  data-bio={bio ?? ''}
  data-video-url={videoUrl ?? ''}
>
  <!-- Photo or gradient fallback -->
  <div class="card-img-wrap">
    {photo
      ? <img src={photo} alt={name} class="card-img" style={photoPosition ? `object-position:${photoPosition};` : undefined} />
      : <div class="card-img-fallback" style={`background:conic-gradient(from 180deg at 50% 60%, hsl(${hue},70%,30%), hsl(${hue2},60%,20%), hsl(${hue},80%,15%));`}>
          <span class="card-initials" style={`color:hsl(${hue},80%,75%);`}>{initials}</span>
        </div>
    }
    {!bio && <div class="card-photo-note">Info Coming Soon...</div>}
  </div>

  <!-- Card body -->
  <div class="card-body">
    <h3 class="card-name">{name}</h3>
  </div>
</div>

<style>
  .artist-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .artist-card:focus-visible {
    outline: 2px solid var(--color-cyan-neon);
    outline-offset: 2px;
  }
  .card-img-wrap {
    height: 11rem;
    overflow: hidden;
    position: relative;
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }
  .artist-card:hover .card-img {
    transform: scale(1.05);
  }
  .card-img-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-initials {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    opacity: 0.7;
    user-select: none;
  }
  .card-photo-note {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.72);
    color: var(--color-cyan-neon);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.6);
  }
  .card-body {
    padding: 1rem;
    text-align: center;
  }
  .card-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: white;
    margin-bottom: 0.25rem;
  }
</style>
