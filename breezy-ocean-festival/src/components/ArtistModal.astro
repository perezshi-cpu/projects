<div id="artist-modal-overlay" class="artist-modal-overlay modal-hidden">
  <div
    id="artist-modal-panel"
    class="artist-modal-panel card-glass"
    role="dialog"
    aria-modal="true"
    aria-labelledby="artist-modal-name"
  >
    <button id="artist-modal-close" class="artist-modal-close" aria-label="סגור" style="background:#000000; color:#00e5ff; z-index:10;">&times;</button>

    <div id="artist-modal-media" class="artist-modal-media"></div>

    <div class="artist-modal-body">
      <h3 id="artist-modal-name" class="artist-modal-name"></h3>
      <p id="artist-modal-meta" class="artist-modal-meta"></p>
      <p id="artist-modal-bio" class="artist-modal-bio"></p>
      <a id="artist-modal-link" class="artist-modal-link" target="_blank" rel="noopener noreferrer">🎧 האזינו</a>
    </div>
  </div>
</div>

<script>
  import { getArtistFallback } from '../lib/artistFallback';
  import { dayLabels } from '../lib/hebrewLabels';

  const overlay = document.getElementById('artist-modal-overlay') as HTMLElement;
  const closeBtn = document.getElementById('artist-modal-close') as HTMLButtonElement;
  const mediaEl = document.getElementById('artist-modal-media') as HTMLElement;
  const nameEl = document.getElementById('artist-modal-name') as HTMLElement;
  const metaEl = document.getElementById('artist-modal-meta') as HTMLElement;
  const bioEl = document.getElementById('artist-modal-bio') as HTMLElement;
  const linkEl = document.getElementById('artist-modal-link') as HTMLAnchorElement;

  const triggers = document.querySelectorAll<HTMLElement>('[data-artist-trigger]');

  let lastFocused: HTMLElement | null = null;

  function openModal(trigger: HTMLElement) {
    const { name = '', day = '', time = '', photo = '', photoPosition = '', bio = '', videoUrl = '' } = trigger.dataset;

    lastFocused = trigger;

    nameEl.textContent = name;
    metaEl.textContent = [dayLabels[day] ?? day, time].filter(Boolean).join(' · ');

    if (bio) {
      bioEl.removeAttribute('dir');
      bioEl.textContent = bio;
    } else {
      bioEl.dir = 'ltr';
      bioEl.textContent = 'Info Coming Soon...';
    }

    if (videoUrl) {
      linkEl.href = videoUrl;
      linkEl.style.display = 'inline-block';
    } else {
      linkEl.removeAttribute('href');
      linkEl.style.display = 'none';
    }

    if (photo) {
      const posStyle = photoPosition ? ` style="object-position:${photoPosition};"` : '';
      mediaEl.innerHTML = `<img src="${photo}" alt="${name}" class="artist-modal-img"${posStyle} />`;
    } else {
      const { hue, hue2, initials } = getArtistFallback(name);
      mediaEl.innerHTML = `
        <div class="artist-modal-fallback" style="background:conic-gradient(from 180deg at 50% 60%, hsl(${hue},70%,30%), hsl(${hue2},60%,20%), hsl(${hue},80%,15%));">
          <span class="artist-modal-initials" style="color:hsl(${hue},80%,75%);">${initials}</span>
        </div>
      `;
    }

    if (!bio) {
      mediaEl.insertAdjacentHTML('beforeend', '<div class="artist-modal-photo-note" dir="ltr">Info Coming Soon...</div>');
    }

    overlay.classList.remove('modal-hidden');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    overlay.classList.add('modal-hidden');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => openModal(trigger));
    trigger.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(trigger);
      }
    });
  });

  closeBtn.addEventListener('click', closeModal);

  overlay.addEventListener('click', (e: MouseEvent) => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && !overlay.classList.contains('modal-hidden')) {
      closeModal();
    }
  });
</script>

<style>
  .artist-modal-overlay.modal-hidden {
    display: none;
  }
  .artist-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .artist-modal-panel {
    position: relative;
    width: 100%;
    max-width: 26rem;
    max-height: 85vh;
    overflow-y: auto;
    padding: 1.5rem;
  }
  .artist-modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-cyan-neon);
    background: #000000 !important;
    color: var(--color-cyan-neon) !important;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .artist-modal-close:hover,
  .artist-modal-close:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--color-cyan-neon);
    outline: none;
  }
  .artist-modal-media {
    position: relative;
    height: 12rem;
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }
  :global(.artist-modal-photo-note) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.72);
    color: var(--color-cyan-neon);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    text-shadow: 0 0 12px rgba(0, 229, 255, 0.6);
  }
  :global(.artist-modal-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  :global(.artist-modal-fallback) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.artist-modal-initials) {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    opacity: 0.7;
    user-select: none;
  }
  .artist-modal-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: white;
    margin-bottom: 0.35rem;
    text-align: center;
  }
  .artist-modal-meta {
    font-size: 0.8rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-gold-warm);
    opacity: 0.9;
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .artist-modal-bio {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    white-space: pre-line;
  }
  .artist-modal-link {
    display: none;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-cyan-neon);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 229, 255, 0.4);
    padding-bottom: 0.15rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .artist-modal-link:hover,
  .artist-modal-link:focus-visible {
    color: white;
    border-color: white;
  }
</style>
