    margin-bottom: 1rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-cyan-neon);
    margin-bottom: 0.875rem;
    letter-spacing: 0.03em;
  }
  .card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-list li {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
