    text-align: center;
    margin-bottom: 4rem;
  }
  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    margin-bottom: 0.75rem;
  }
  .info-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .info-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.45);
    max-width: 32rem;
    margin: 0 auto;
  }
  .info-grid {
    display: flex;
    justify-content: center;
  }
  .info-card {
    width: 100%;
    max-width: 32rem;
    padding: 1.75rem;
