---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "MATAN'A Festival",
  description = "Where sound meets the infinite. September 17–19, 2026. Desert Oasis, Shitim.",
} = Astro.props;

const ogImageUrl = new URL('/og-image.jpg', Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
  <head>
    <script is:inline>
      // Mobile browsers restore the scroll offset a tab had before a plain
      // reload (not just back/forward) — so scrolling to Lineup, opening an
      // artist, then refreshing reopens mid-page instead of at the Hero.
      // Opting out here makes every load start at the top by default.
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      // In-page nav links (nav bar, "תוכניה" CTA) point at #lineup etc.
      // Once clicked, that hash sits in the address bar and gets copied
      // along when someone shares the URL — so every fresh visitor who
      // opens that shared link lands mid-page instead of at the Hero.
      // Stripping the hash before the browser's native fragment-scroll
      // runs keeps first loads always starting at the top; in-page nav
      // clicks still work normally since those set the hash fresh.
      if (location.hash) {
        history.replaceState(null, '', location.pathname + location.search);
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph (WhatsApp, Facebook, iMessage, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:url" content={pageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
